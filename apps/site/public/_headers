# Security headers for every page (Cloudflare static assets read this file).
# Scripts only from the site itself (build.mjs moves the inline ones to /js/) and Cloudflare's
# analytics beacon; no framing.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: script-src 'self' https://static.cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# The update beacon: always checked with the server (it answers 304 when unchanged), so copies see a
# new release within minutes of the deploy. Read by the app's server, not a browser: no CORS needed.
/v1/latest.json
  Cache-Control: no-cache
  Content-Type: application/json; charset=utf-8

# Scripts are named by their content, so a changed one gets a new name: cache them for good.
/js/*
  Cache-Control: public, max-age=31536000, immutable

# Shared CSS is named by its content too (build.mjs): cache it for good.
/css/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts only change with a new font release; a year, revalidated after that.
/fonts/*
  Cache-Control: public, max-age=31536000

# Screenshots, the share image and the icon keep their names when they change, so cache them for a
# while, not for good.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
