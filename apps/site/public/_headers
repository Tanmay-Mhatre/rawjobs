# Security headers for every page (Cloudflare static assets read this file).
# No script-src CSP yet: the page's scripts are inline. Framing is refused, though.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# The update beacon: always checked with the server (it answers 304 when unchanged), so copies see a
# new release within minutes of the deploy. Read by the app's server, not a browser: no CORS needed.
/v1/latest.json
  Cache-Control: no-cache
  Content-Type: application/json; charset=utf-8
